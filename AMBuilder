import os


def collectPluginSources(platform):
  sources = []
  source_root = os.path.join(builder.sourcePath, 'src')
  for root, _, filenames in os.walk(source_root):
    for filename in filenames:
      if not filename.endswith('.cpp'):
        continue
      if platform == 'windows' and filename.endswith('_linux.cpp'):
        continue
      if platform == 'linux' and filename.endswith(('_win.cpp', '_windows.cpp')):
        continue
      sources.append(os.path.join(root, filename))
  return sorted(sources)


sdk_target = MMSPlugin.sdk_target
sdk = sdk_target.sdk
cxx = sdk_target.cxx

binary = MMSPlugin.HL2Library(builder, cxx, MMSPlugin.metadata['name'], sdk)

if binary.compiler.family in ('gcc', 'clang'):
  binary.compiler.defines += ['_GLIBCXX_USE_CXX11_ABI=0']

if builder.options.opt == '1' and builder.options.debug != '1' and cxx.target.platform == 'linux':
  binary.compiler.linkflags += ['-Wl,-s']

binary.compiler.cxxincludes += [
  os.path.join(builder.sourcePath, 'src'),
]

binary.sources += collectPluginSources(cxx.target.platform)

MMSPlugin.binaries = [builder.Add(binary)]
